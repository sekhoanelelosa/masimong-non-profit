@{
    ViewData["Title"] = "Contact";
}
<div class="container contact-page">
   <div class="text-center mb-5">
       
     <h1>Contact Us</h1>
        <span class="hero-badge">Get in Touch</span>
         <p>
            We'd love to hear from you. Whether you have a question,
            would like to volunteer, or want to partner with us,
            we're here to help.
         </p>

    </div>
          <div class="contact-grid">
              <div class="glass-card">
                  <h3>Send a Message</h3>
                      
                  <form>
                        <div class="mb-3"> <input type="text" class="form-control" placeholder="Your Name"></div>
                        <div class="mb-3"> <input type="email"class="form-control"placeholder="Email Address"></div>
                        <div class="mb-3"> <input type="text"class="form-control"placeholder="Subject"></div>
                        <div class="mb-3"><textarea class="form-control"rows="6"placeholder="Your Message"></textarea></div>

                        <button class="btn btn-primary">Send Message</button>
                  </form>

               </div>

               <div class="glass-card">
                   <h3>Contact Information</h3>
